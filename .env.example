# 数据库（相对 prisma/ 目录，即项目根 data/dev.db）
DATABASE_URL="file:../data/dev.db"

# 主密钥：用于 AES-256-GCM 加密存储各平台 API Key
# 生成方式（任选一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
# ⚠️ 丢失该密钥 = 已保存的所有平台 Key 全部无法解密，请妥善备份
FREEVIDEO_MASTER_KEY="请替换成你的32字节base64密钥"

# 可选：公网基地址。部分上游只接受公网 URL 的首尾帧图片
# 填内网穿透地址（如 http://xxx.ngrok.io）或公网服务器地址；不填则自动降级为 base64 直传
PUBLIC_BASE_URL=""
